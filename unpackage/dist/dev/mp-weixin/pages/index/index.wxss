.index {
  padding: 20rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}
.index .search-box {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}
.index .search-box .search-input {
  flex: 1;
  margin: 0 16rpx;
  font-size: 28rpx;
  color: #333;
}
.index .search-results {
  margin-bottom: 20rpx;
}
.index .tools-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  padding: 10rpx;
}
.index .tool-item {
  position: relative;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 16rpx 12rpx;
  text-align: center;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.2s ease, opacity 0.2s ease;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
}
.index .tool-item.dragging {
  opacity: 0.8;
  transform: scale(1.02);
  z-index: 100;
  background-color: #f8f8f8;
}
.index .tool-content {
  position: relative;
  z-index: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 12rpx 12rpx;
  min-height: 120rpx;
}
.index .tool-name {
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
  width: 100%;
  text-overflow: ellipsis;
  overflow: hidden;
  white-space: nowrap;
  padding: 0 6rpx;
}
.index .add-favorite,
.index .remove-favorite {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  padding: 16rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}
.index .add-favorite:active,
.index .remove-favorite:active {
  opacity: 0.7;
}
.index .show-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  color: #666;
  font-size: 28rpx;
  gap: 8rpx;
}
.index .empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 28rpx;
  gap: 16rpx;
  background-color: #fff;
  border-radius: 12rpx;
  margin: 16rpx;
}
.index .drag-handle {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  padding: 16rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: move;
  transform: rotate(90deg);
}
.index .drag-handle:active {
  opacity: 0.7;
}
.index .uni-section {
  padding: 0 !important;
  margin-bottom: 20rpx;
}
.index .uni-section .uni-section-header {
  padding: 0 10rpx;
}
.index .contact-box {
  margin: 30rpx 10rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  cursor: pointer;
}
.index .contact-box:active {
  opacity: 0.7;
}
.index .contact-box text {
  font-size: 28rpx;
  color: #1677ff;
}
.index .qr-popup {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  width: 560rpx;
  text-align: center;
}
.index .qr-popup .qr-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}
.index .qr-popup .qr-image {
  width: 400rpx;
  height: 400rpx;
  margin: 20rpx 0;
}
.index .qr-popup .qr-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}
.index .qr-popup .close-btn {
  margin-top: 30rpx;
  background-color: #1677ff;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 16rpx 0;
}
.index .qr-popup .close-btn:active {
  opacity: 0.8;
}